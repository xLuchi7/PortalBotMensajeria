<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Portal de Clientes</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<div class="app-shell">
  <aside class="sidebar">
    <div class="sidebar-brand"><%- icons.bot %> Portal</div>

    <% if (usuario.rol === 'admin') { %>
      <div class="sidebar-section">Administración</div>
      <nav class="sidebar-nav">
        <a href="/clientes" class="<%= currentPath.startsWith('/clientes') && !currentPath.match(/^\/clientes\/\d/) ? 'active' : '' %>">
          <%- icons.briefcase %><span class="label">Clientes</span>
        </a>
        <a href="/usuarios" class="<%= currentPath.startsWith('/usuarios') ? 'active' : '' %>">
          <%- icons.users %><span class="label">Usuarios</span>
        </a>
      </nav>
      <% if (typeof cliente !== 'undefined' && cliente) { %>
        <div class="sidebar-section">Viendo: <%= cliente.razonSocial %></div>
        <nav class="sidebar-nav">
          <a href="/clientes/<%= clienteId %>/mensajes" class="<%= currentPath.endsWith('/mensajes') ? 'active' : '' %>">
            <%- icons.message %><span class="label">Mensajes</span>
          </a>
          <a href="/clientes/<%= clienteId %>/escalamientos" class="<%= currentPath.endsWith('/escalamientos') ? 'active' : '' %>">
            <%- icons.alertTriangle %><span class="label">Escalamientos</span>
          </a>
          <a href="/clientes/<%= clienteId %>/pedidos" class="<%= currentPath.includes('/pedidos') ? 'active' : '' %>">
            <%- icons.truck %><span class="label">Pedidos</span>
          </a>
        </nav>
      <% } %>
    <% } else { %>
      <div class="sidebar-section">Tu cuenta</div>
      <nav class="sidebar-nav">
        <a href="/clientes/<%= usuario.clienteId %>/mensajes" class="<%= currentPath.endsWith('/mensajes') ? 'active' : '' %>">
          <%- icons.message %><span class="label">Mensajes</span>
        </a>
        <a href="/clientes/<%= usuario.clienteId %>/escalamientos" class="<%= currentPath.endsWith('/escalamientos') ? 'active' : '' %>">
          <%- icons.alertTriangle %><span class="label">Escalamientos</span>
        </a>
        <a href="/clientes/<%= usuario.clienteId %>/pedidos" class="<%= currentPath.includes('/pedidos') ? 'active' : '' %>">
          <%- icons.truck %><span class="label">Pedidos</span>
        </a>
      </nav>
    <% } %>

    <div class="sidebar-footer">
      <div class="sidebar-user">
        <strong><%= usuario.rol === 'admin' ? 'Panel Admin' : usuario.razonSocial %></strong>
        <%= usuario.email %>
      </div>
      <form method="POST" action="/logout" class="inline" style="width: 100%;">
        <button type="submit" class="btn-logout"><%- icons.logOut %><span class="label">Salir</span></button>
      </form>
    </div>
  </aside>

  <main class="main">
