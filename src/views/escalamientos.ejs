<%- include('partials/header') %>

<div class="topbar"><h1>Escalamientos</h1></div>

<div class="card">
  <div class="card-header">
    <span><strong><%= total %></strong>&nbsp;en total</span>
    <span><%= pendientes %> pendientes</span>
  </div>
  <% if (!rows.length) { %>
    <div class="empty-state">
      <%- icons.alertTriangle %>
      <p>No hay escalamientos.</p>
    </div>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Fecha</th><th>Usuario</th><th>Motivo</th><th class="col-center">Estado</th></tr>
        </thead>
        <tbody>
          <% rows.forEach(e => { %>
            <tr>
              <td><%= e.fecha %></td>
              <td><%= e.userId %></td>
              <td><%= e.motivo %></td>
              <td class="col-center">
                <% if (e.estado === 'resuelto') { %>
                  <span class="badge badge-resuelto">Resuelto</span>
                <% } else { %>
                  <form method="POST" action="/clientes/<%= clienteId %>/escalamientos/<%= e.id %>/estado" class="inline">
                    <select name="estado" onchange="this.form.submit()" class="badge-select badge-<%= e.estado %>">
                      <option value="pendiente" <%= e.estado === 'pendiente' ? 'selected' : '' %>>Pendiente</option>
                      <option value="en_proceso" <%= e.estado === 'en_proceso' ? 'selected' : '' %>>En proceso</option>
                      <option value="resuelto">Resuelto</option>
                    </select>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <%- include('partials/pagination') %>
  <% } %>
</div>

<%- include('partials/footer') %>
