<%- include('partials/header') %>

<% const conShopify = typeof shopifyConexion !== 'undefined' && shopifyConexion; %>
<% const mostrarShopify = conShopify || rows.some(p => p.shopifyEstado); %>
<div class="page-head">
  <div>
    <h1>Pedidos</h1>
    <p class="page-sub">Lo que tus clientes compraron por WhatsApp. Cambiá el estado desde la etiqueta de cada pedido.</p>
  </div>
</div>
<details class="page-help">
  <summary><%- icons.info %> ¿Cómo funcionan los estados?</summary>
  <div>
    <% if (conShopify) { %>
      <p>Al pasar un pedido a <strong>Confirmado</strong> se crea en tu tienda de Shopify con el pago pendiente y Shopify descuenta el stock. Si lo cancelás después, también se cancela en Shopify.</p>
      <p>Un pedido pasa a <strong>Reclamado</strong> solo cuando el bot detecta un reclamo; al marcarlo <strong>Solucionado</strong> se resuelve el escalamiento asociado (la devolución de stock se maneja en Shopify).</p>
    <% } else { %>
      <p>Al marcar un pedido como <strong>Entregado</strong> se descuenta el stock de cada artículo.</p>
      <p>Un pedido pasa a <strong>Reclamado</strong> solo cuando el bot detecta un reclamo; al marcarlo <strong>Solucionado</strong> se devuelve el stock y se resuelve el escalamiento asociado.</p>
    <% } %>
    <p><strong>Entregado</strong>, <strong>Cancelado</strong> y <strong>Solucionado</strong> son estados finales: después no se pueden cambiar.</p>
  </div>
</details>

<div class="stats">
  <div class="stat"><span class="stat-icon tone-primary"><%- icons.truck %></span><div><strong><%= total %></strong><span>pedido<%= total === 1 ? '' : 's' %> en total</span></div></div>
  <div class="stat"><span class="stat-icon tone-success"><%- icons.wallet %></span><div><strong><%= plata(totalMonto) %></strong><span>vendido por el bot</span></div></div>
  <div class="stat <%= pendientes ? 'stat-alert-warning' : '' %>"><span class="stat-icon tone-warning"><%- icons.clock %></span><div><strong><%= pendientes %></strong><span>esperando confirmación</span></div></div>
  <div class="stat <%= reclamados ? 'stat-alert-danger' : '' %>"><span class="stat-icon tone-danger"><%- icons.alertTriangle %></span><div><strong><%= reclamados %></strong><span>con reclamo</span></div></div>
</div>

<div class="card">
  <% if (!rows.length) { %>
    <div class="empty-state">
      <%- icons.truck %>
      <h3>Todavía no hay pedidos</h3>
      <p>Cuando un cliente confirme una compra por WhatsApp, el pedido va a aparecer acá.</p>
    </div>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th class="col-id">#</th><th class="col-fecha">Fecha</th><th>Cliente</th><th class="col-num">Total</th><th class="col-center">Estado</th><% if (mostrarShopify) { %><th class="col-center">Shopify</th><% } %><th>Notas</th><th></th></tr>
        </thead>
        <tbody>
          <% const ESTADOS_FINALES = ['entregado', 'cancelado', 'solucionado']; %>
          <% const ESTADO_LABEL = { entregado: 'Entregado', cancelado: 'Cancelado', solucionado: 'Solucionado' }; %>
          <% rows.forEach(p => { %>
            <tr>
              <td class="cell-id">#<%= p.id %></td>
              <td class="col-fecha"><% const f = fecha(p.fecha); %><div class="cell-fecha"><span><%= f.dia %></span><small><%= f.hora %></small></div></td>
              <td><a class="contacto" href="/clientes/<%= clienteId %>/chats?chat=<%= encodeURIComponent(p.userId) %>" title="Abrir el chat"><%- icons.message %><% if (p.contactoNombre) { %><span class="contacto-texto"><strong><%= p.contactoNombre %></strong><small><%= numero(p.userId) %></small></span><% } else { %><%= numero(p.userId) %><% } %></a></td>
              <td class="col-num"><strong><%= plata(p.total) %></strong></td>
              <td class="col-center">
                <% if (p.estado === 'reclamado') { %>
                  <form method="POST" action="/clientes/<%= clienteId %>/pedidos/<%= p.id %>/estado" class="inline">
                    <select name="estado" onchange="this.form.submit()" class="badge-select badge-reclamado">
                      <option value="reclamado" selected>Reclamado</option>
                      <option value="solucionado">Solucionado</option>
                    </select>
                  </form>
                <% } else if (ESTADOS_FINALES.includes(p.estado)) { %>
                  <span class="badge badge-<%= p.estado %>"><%= ESTADO_LABEL[p.estado] %></span>
                <% } else { %>
                  <form method="POST" action="/clientes/<%= clienteId %>/pedidos/<%= p.id %>/estado" class="inline">
                    <select name="estado" onchange="this.form.submit()" class="badge-select badge-<%= p.estado %>">
                      <option value="pendiente" <%= p.estado === 'pendiente' ? 'selected' : '' %>>Pendiente</option>
                      <option value="confirmado" <%= p.estado === 'confirmado' ? 'selected' : '' %>>Confirmado</option>
                      <option value="entregado">Entregado</option>
                      <option value="cancelado">Cancelado</option>
                    </select>
                  </form>
                <% } %>
              </td>
              <% if (mostrarShopify) { %>
                <td class="col-center">
                  <div class="shopify-cell">
                    <% if (p.shopifyOrderId) { %>
                      <a href="https://<%= conShopify ? shopifyConexion.shopDomain : '' %>/admin/orders/<%= String(p.shopifyOrderId).split('/').pop() %>" target="_blank" rel="noopener"
                         title="<%= p.shopifyError || (p.shopifyEstado === 'cancelado' ? 'Cancelado en Shopify' : 'Ver en Shopify') %>"
                         <%= conShopify ? '' : 'onclick="return false"' %>>
                        <%= p.shopifyOrderName || 'Ver' %><%- icons.externalLink %>
                      </a>
                      <% if (p.shopifyError) { %><span title="<%= p.shopifyError %>" style="color: var(--warning); display: inline-flex;"><%- icons.alertTriangle %></span><% } %>
                    <% } else if (p.shopifyEstado === 'error') { %>
                      <span class="badge badge-cancelado" style="width: auto;" title="<%= p.shopifyError %>">Error</span>
                      <% if (conShopify) { %>
                        <form method="POST" action="/clientes/<%= clienteId %>/pedidos/<%= p.id %>/shopify/reintentar" class="inline">
                          <button type="submit" class="icon-btn" title="Reintentar envío a Shopify: <%= p.shopifyError %>"><%- icons.refresh %></button>
                        </form>
                      <% } %>
                    <% } else if (p.shopifyEstado === 'enviando') { %>
                      <span class="field-hint">Enviando…</span>
                      <% if (conShopify) { %>
                        <form method="POST" action="/clientes/<%= clienteId %>/pedidos/<%= p.id %>/shopify/reintentar" class="inline">
                          <button type="submit" class="icon-btn" title="Reintentar envío a Shopify"><%- icons.refresh %></button>
                        </form>
                      <% } %>
                    <% } else { %>
                      <span class="field-hint">-</span>
                    <% } %>
                  </div>
                </td>
              <% } %>
              <td>
                <div class="notas-cell">
                  <span><%= p.notas || '-' %></span>
                  <button type="button" class="icon-btn" title="Editar notas" onclick="abrirNotas(<%= p.id %>, <%= JSON.stringify(p.notas || '') %>)"><%- icons.edit %></button>
                </div>
              </td>
              <td>
                <button type="button" class="icon-btn" title="Ver detalle" onclick="abrirDetalle(<%= p.id %>)"><%- icons.eye %></button>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <%- include('partials/pagination') %>
  <% } %>
</div>

<dialog id="notas-dialog" class="modal">
  <form method="POST" id="notas-form">
    <h3>Notas del pedido #<span id="notas-dialog-pedido"></span></h3>
    <textarea name="notas" id="notas-textarea" rows="5" maxlength="500" placeholder="Sin notas"></textarea>
    <div class="modal-actions">
      <button type="button" class="btn btn-outline" onclick="document.getElementById('notas-dialog').close()">Cancelar</button>
      <button type="submit" class="btn btn-primary">Guardar</button>
    </div>
  </form>
</dialog>

<dialog id="detalle-dialog" class="modal modal-wide">
  <h3>Pedido #<span id="detalle-dialog-pedido"></span></h3>
  <div class="table-wrap" style="margin-bottom: 1.1rem;">
    <table>
      <thead>
        <tr><th>Artículo</th><th class="col-center">Cantidad</th><th>Precio unitario</th><th>Subtotal</th><th>Total</th></tr>
      </thead>
      <tbody id="detalle-items"></tbody>
    </table>
  </div>
  <div class="modal-actions">
    <button type="button" class="btn btn-primary" onclick="document.getElementById('detalle-dialog').close()">Cerrar</button>
  </div>
</dialog>

<script>
  const CLIENTE_ID = <%= clienteId %>;
  function abrirNotas(pedidoId, notas) {
    document.getElementById('notas-form').action = `/clientes/${CLIENTE_ID}/pedidos/${pedidoId}/notas`;
    document.getElementById('notas-dialog-pedido').textContent = pedidoId;
    document.getElementById('notas-textarea').value = notas;
    document.getElementById('notas-dialog').showModal();
  }

  function escapeHtml(s) {
    return String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  }

  function abrirDetalle(pedidoId) {
    document.getElementById('detalle-dialog-pedido').textContent = pedidoId;
    const tbody = document.getElementById('detalle-items');
    tbody.innerHTML = '<tr><td colspan="5">Cargando…</td></tr>';
    document.getElementById('detalle-dialog').showModal();

    fetch(`/clientes/${CLIENTE_ID}/pedidos/${pedidoId}/detalle.json`)
      .then(r => r.json())
      .then(data => {
        let acumulado = 0;
        tbody.innerHTML = data.items.map(i => {
          acumulado += Number(i.subtotal);
          return `
            <tr>
              <td>${escapeHtml(i.nombre)}</td>
              <td class="col-center">${i.cantidad}</td>
              <td>$${Number(i.precioUnitario).toLocaleString('es-AR')}</td>
              <td>$${Number(i.subtotal).toLocaleString('es-AR')}</td>
              <td>$${acumulado.toLocaleString('es-AR')}</td>
            </tr>
          `;
        }).join('');
      })
      .catch(() => {
        tbody.innerHTML = '<tr><td colspan="5">Ocurrió un error al cargar el detalle.</td></tr>';
      });
  }
</script>

<%- include('partials/footer') %>
