<%- include('partials/header') %>

<div class="breadcrumb">
  <a href="/usuarios"><%- icons.arrowLeft %> Usuarios</a>
</div>
<div class="topbar"><h1><%= editar ? 'Editar usuario' : 'Nuevo usuario' %></h1></div>

<% if (error) { %>
  <div class="alert alert-error"><%= error %></div>
<% } %>

<div class="card form-card">
  <form method="POST" action="<%= editar ? `/usuarios/${editar.id}/editar` : '/usuarios/nuevo' %>">
    <label>
      Email
      <input type="email" name="email" value="<%= editar ? editar.email : '' %>" required>
    </label>
    <label>
      Contraseña <% if (editar) { %><span class="field-hint">(dejar en blanco para no cambiarla)</span><% } %>
      <input type="password" name="password" <%= editar ? '' : 'required' %>>
    </label>
    <label>
      Rol
      <select name="rol" id="rol" onchange="document.getElementById('clienteField').style.display = this.value === 'admin' ? 'none' : 'block';">
        <option value="cliente" <%= (!editar || editar.rol === 'cliente') ? 'selected' : '' %>>Cliente</option>
        <option value="admin" <%= (editar && editar.rol === 'admin') ? 'selected' : '' %>>Admin</option>
      </select>
    </label>
    <div id="clienteField" style="display: <%= (editar && editar.rol === 'admin') ? 'none' : 'block' %>;">
      <label>
        Cliente
        <select name="clienteId">
          <option value="">-- Seleccionar --</option>
          <% clientesActivos.forEach(c => { %>
            <option value="<%= c.id %>" <%= (editar && editar.clienteId === c.id) ? 'selected' : '' %>><%= c.razonSocial %></option>
          <% }) %>
        </select>
      </label>
    </div>
    <button type="submit" class="btn btn-primary"><%= editar ? 'Guardar cambios' : 'Crear usuario' %></button>
  </form>
</div>

<%- include('partials/footer') %>
