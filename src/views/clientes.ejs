<%- include('partials/header') %>

<div class="page-head">
  <div>
    <h1>Clientes</h1>
    <p class="page-sub">Los negocios que usan el bot. Entrá a cualquiera para ver sus chats, pedidos y configuración.</p>
  </div>
  <div class="page-actions"><a href="/clientes/nuevo" class="btn btn-primary"><%- icons.plus %> Nuevo cliente</a></div>
</div>

<div class="stats">
  <div class="stat"><span class="stat-icon tone-primary"><%- icons.briefcase %></span><div><strong><%= total %></strong><span>cliente<%= total === 1 ? '' : 's' %></span></div></div>
  <div class="stat"><span class="stat-icon tone-success"><%- icons.check %></span><div><strong><%= activos %></strong><span>activos</span></div></div>
</div>

<div class="card">
  <% if (!rows.length) { %>
    <div class="empty-state">
      <%- icons.briefcase %>
      <p>No hay clientes cargados.</p>
    </div>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Razón social</th><th>CUIT</th><th>Teléfono</th><th>Email</th><th class="col-center">Estado</th><th></th></tr>
        </thead>
        <tbody>
          <% rows.forEach(c => { %>
            <tr class="<%= !c.activo ? 'row-inactive' : '' %>">
              <td><a href="/clientes/<%= c.id %>/chats" class="cell-cliente"><span class="avatar avatar-sm"><%= iniciales(c.razonSocial) %></span><strong><%= c.razonSocial %></strong></a></td>
              <td class="nowrap"><%= c.cuit %></td>
              <td class="nowrap"><%= numero(c.telefono) %></td>
              <td><%= c.email || '-' %></td>
              <td class="col-center"><span class="badge <%= c.activo ? 'badge-activo' : 'badge-inactivo' %>"><%= c.activo ? 'Activo' : 'Inactivo' %></span></td>
              <td>
                <div class="cell-actions">
                  <a href="/clientes/<%= c.id %>/chats" class="btn btn-accent btn-sm">Entrar <%- icons.arrowLeft.replace('class="icon"', 'class="icon icon-flip"') %></a>
                  <a href="/clientes/<%= c.id %>/editar" class="icon-btn" title="Editar"><%- icons.edit %></a>
                  <% if (c.activo) { %>
                    <form method="POST" action="/clientes/<%= c.id %>/borrar" class="inline">
                      <button type="button" class="icon-btn danger" title="Desactivar"
                              onclick="confirmarEliminar('¿Desactivar a «<%= c.razonSocial %>»? Deja de poder usar el bot y el portal, pero no se borra su historial.', this.closest('form'))"><%- icons.trash %></button>
                    </form>
                  <% } else { %>
                    <form method="POST" action="/clientes/<%= c.id %>/activar" class="inline">
                      <button type="submit" class="icon-btn" title="Reactivar"><%- icons.refresh %></button>
                    </form>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <%- include('partials/pagination') %>
  <% } %>
</div>

<%- include('partials/footer') %>
