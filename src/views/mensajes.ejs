<%- include('partials/header') %>

<div class="topbar"><h1>Mensajes</h1></div>

<div class="card">
  <% if (!mensajes.length) { %>
    <div class="empty-state">
      <%- icons.inbox %>
      <p>Todavía no hay mensajes.</p>
    </div>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Fecha</th><th>Usuario</th><th>Plataforma</th><th>Quién</th><th>Mensaje</th></tr>
        </thead>
        <tbody>
          <% mensajes.forEach(m => { %>
            <tr class="<%= m.esError ? 'row-error' : '' %>">
              <td><%= new Date(m.fecha).toLocaleString('es-AR') %></td>
              <td><%= m.userId %></td>
              <td><%= m.platform %></td>
              <td>
                <span class="badge <%= m.role === 'user' ? 'badge-cliente' : 'badge-info' %>">
                  <%= m.role === 'user' ? 'Cliente' : 'Bot' %>
                </span>
              </td>
              <td><%= m.content %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
