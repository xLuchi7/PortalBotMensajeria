<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Portal de Clientes</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<%
  // Un solo menú para admin y cliente: el admin lo ve cuando entra a un Cliente
  // puntual, el cliente siempre con el suyo. Para sumar una página, agregala acá.
  const esAdmin = usuario.rol === 'admin';
  const clienteActual = typeof cliente !== 'undefined' && cliente ? cliente : null;
  const navClienteId = esAdmin ? (clienteActual ? clienteId : null) : usuario.clienteId;
  const grupos = [
    { titulo: 'Atención', items: [
      { ruta: 'chats', label: 'Chats', icono: 'message' },
      { ruta: 'escalamientos', label: 'Escalamientos', icono: 'alertTriangle' },
      { ruta: 'consultas', label: 'Consultas', icono: 'search' },
    ] },
    { titulo: 'Ventas', items: [
      { ruta: 'pedidos', label: 'Pedidos', icono: 'truck' },
      { ruta: 'articulos', label: 'Artículos', icono: 'package' },
    ] },
    { titulo: 'Configuración', items: [
      { ruta: 'negocio', label: 'Mi Negocio', icono: 'fileText' },
      { ruta: 'integraciones', label: 'Integraciones', icono: 'plug' },
    ] },
  ];
  const activa = ruta => currentPath.startsWith(`/clientes/${navClienteId}/${ruta}`);
  const nombreUsuario = esAdmin ? 'Administrador' : (usuario.razonSocial || usuario.email);
%>
<div class="app-shell">
  <aside class="sidebar">
    <div class="sidebar-brand">
      <span class="brand-mark"><%- icons.bot %></span>
      <span class="brand-text"><strong>Portal</strong><small>Tu asistente de ventas</small></span>
    </div>

    <% if (esAdmin) { %>
      <div class="sidebar-section">Administración</div>
      <nav class="sidebar-nav">
        <a href="/clientes" class="<%= currentPath.startsWith('/clientes') && !/^\/clientes\/\d/.test(currentPath) ? 'active' : '' %>">
          <%- icons.briefcase %><span class="label">Clientes</span>
        </a>
        <a href="/usuarios" class="<%= currentPath.startsWith('/usuarios') ? 'active' : '' %>">
          <%- icons.users %><span class="label">Usuarios</span>
        </a>
      </nav>
    <% } %>

    <% if (navClienteId) { %>
      <% if (esAdmin && clienteActual) { %>
        <div class="sidebar-viendo">
          <span class="avatar avatar-sm"><%= iniciales(clienteActual.razonSocial) %></span>
          <span><small>Viendo</small><%= clienteActual.razonSocial %></span>
        </div>
      <% } %>

      <% if (clienteActual && typeof clienteActual.botActivo === 'boolean') { %>
        <a href="/clientes/<%= navClienteId %>/negocio" class="sidebar-bot <%= clienteActual.botActivo ? 'is-on' : 'is-off' %>"
           title="<%= clienteActual.botActivo ? 'El bot está respondiendo. Tocá para ir a apagarlo.' : 'El bot está apagado. Tocá para ir a encenderlo.' %>">
          <span class="sidebar-bot-avatar"><%- icons.bot %><span class="sidebar-bot-dot"></span></span>
          <span class="sidebar-bot-text">
            <small>Tu asistente</small>
            <strong><%= clienteActual.botActivo ? 'Respondiendo' : 'Apagado' %></strong>
          </span>
          <span class="mini-switch" aria-hidden="true"><span></span></span>
        </a>
      <% } %>

      <% grupos.forEach(g => { %>
        <div class="sidebar-section"><%= g.titulo %></div>
        <nav class="sidebar-nav">
          <% g.items.forEach(i => { %>
            <a href="/clientes/<%= navClienteId %>/<%= i.ruta %>" class="<%= activa(i.ruta) ? 'active' : '' %>">
              <%- icons[i.icono] %><span class="label"><%= i.label %></span>
            </a>
          <% }) %>
        </nav>
      <% }) %>
    <% } %>

    <div class="sidebar-footer">
      <span class="avatar"><%= iniciales(nombreUsuario) %></span>
      <div class="sidebar-user">
        <strong><%= nombreUsuario %></strong>
        <span><%= usuario.email %></span>
      </div>
      <form method="POST" action="/logout" class="inline">
        <button type="submit" class="btn-logout" title="Salir" aria-label="Salir"><%- icons.logOut %></button>
      </form>
    </div>
  </aside>

  <main class="main">
