  </main>
</div>
<div class="toast-container" id="toast-container"></div>

<dialog id="confirm-dialog" class="modal">
  <h3>¿Eliminar?</h3>
  <p class="page-hint" id="confirm-dialog-texto" style="margin: 0 0 1.25rem;"></p>
  <div class="modal-actions">
    <button type="button" class="btn btn-outline" onclick="document.getElementById('confirm-dialog').close()">Cancelar</button>
    <button type="button" class="btn btn-danger-outline" id="confirm-dialog-btn">Eliminar</button>
  </div>
</dialog>

<script>
  let _confirmForm = null;
  function confirmarEliminar(mensaje, form) {
    _confirmForm = form;
    document.getElementById('confirm-dialog-texto').textContent = mensaje;
    document.getElementById('confirm-dialog').showModal();
  }
  document.getElementById('confirm-dialog-btn').addEventListener('click', () => {
    document.getElementById('confirm-dialog').close();
    if (_confirmForm) _confirmForm.submit();
  });
</script>

<script>
  const ICON_TOAST_CHECK = `<%- icons.check %>`;
  const ICON_TOAST_WARN = `<%- icons.alertTriangle %>`;
  const ICON_TOAST_CLOSE = `<%- icons.x %>`;

  function mostrarToast(tipo, mensaje) {
    const container = document.getElementById('toast-container');
    if (!container) return;

    const toast = document.createElement('div');
    toast.className = 'toast toast-' + tipo;
    toast.innerHTML =
      '<div class="toast-icon">' + (tipo === 'success' ? ICON_TOAST_CHECK : ICON_TOAST_WARN) + '</div>' +
      '<div class="toast-text"></div>' +
      '<button type="button" class="toast-close" aria-label="Cerrar">' + ICON_TOAST_CLOSE + '</button>' +
      '<div class="toast-progress"></div>';
    toast.querySelector('.toast-text').textContent = mensaje;
    toast.querySelector('.toast-close').addEventListener('click', () => cerrarToast(toast));

    container.appendChild(toast);
    toast._timer = setTimeout(() => cerrarToast(toast), 3200);
  }

  function cerrarToast(toast) {
    if (!toast || toast.classList.contains('toast-hide')) return;
    clearTimeout(toast._timer);
    toast.classList.add('toast-hide');
    setTimeout(() => toast.remove(), 220);
  }

  <% if (typeof flash !== 'undefined' && flash) { %>
    mostrarToast('<%= flash.type %>', <%- JSON.stringify(flash.message) %>);
  <% } %>

  // Reemplaza el globo de validación nativo del navegador por un toast, en
  // cualquier formulario de la página — no hace falta tocar cada form.
  document.querySelectorAll('form').forEach(form => {
    form.setAttribute('novalidate', 'novalidate');
    form.addEventListener('submit', (e) => {
      if (form.checkValidity()) return;
      e.preventDefault();

      const invalido = form.querySelector(':invalid');
      if (!invalido) {
        mostrarToast('warning', 'Revisá los Campos del Formulario');
        return;
      }

      invalido.classList.add('field-invalid');
      invalido.addEventListener('input', () => invalido.classList.remove('field-invalid'), { once: true });
      invalido.focus();

      const label = invalido.closest('label');
      let campo = 'un Campo Obligatorio';
      if (label && label.childNodes[0] && label.childNodes[0].nodeType === Node.TEXT_NODE) {
        campo = label.childNodes[0].textContent.trim();
      }
      mostrarToast('warning', `Falta Completar "${campo}"`);
    });
  });
</script>
</body>
</html>
