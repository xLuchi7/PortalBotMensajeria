<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Portal de Clientes</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css">
</head>
<body>
<header class="container">
  <nav>
    <ul><li><strong><%= usuario.rol === 'admin' ? 'Panel Admin' : usuario.razonSocial %></strong></li></ul>
    <ul>
      <% if (usuario.rol === 'admin') { %>
        <li><a href="/clientes">Clientes</a></li>
        <li><a href="/usuarios">Usuarios</a></li>
      <% } else { %>
        <li><a href="/clientes/<%= usuario.clienteId %>/mensajes">Mensajes</a></li>
        <li><a href="/clientes/<%= usuario.clienteId %>/escalamientos">Escalamientos</a></li>
        <li><a href="/clientes/<%= usuario.clienteId %>/pedidos">Pedidos</a></li>
      <% } %>
    </ul>
    <ul>
      <li>
        <form method="POST" action="/logout" style="margin: 0;">
          <button type="submit" class="secondary outline">Salir</button>
        </form>
      </li>
    </ul>
  </nav>
  <% if (usuario.rol === 'admin' && typeof cliente !== 'undefined' && cliente) { %>
    <p><a href="/clientes">&larr; Volver a Clientes</a> — viendo: <strong><%= cliente.razonSocial %></strong></p>
  <% } %>
</header>
<main class="container">
