<%- include('partials/header') %>

<div class="topbar">
  <h1>Clientes</h1>
  <a href="/clientes/nuevo" class="btn btn-primary"><%- icons.plus %> Nuevo cliente</a>
</div>
<p class="page-hint">Cada fila es un negocio que usa el bot (no sus clientes finales). Desde acá accedés a sus Pedidos, Artículos, Mensajes, Consultas y Escalamientos, y podés desactivarlo sin perder su historial.</p>

<div class="card">
  <div class="card-header">
    <span><strong><%= total %></strong>&nbsp;cliente<%= total === 1 ? '' : 's' %></span>
    <span><%= activos %> activos</span>
  </div>
  <% if (!rows.length) { %>
    <div class="empty-state">
      <%- icons.briefcase %>
      <p>No hay clientes cargados.</p>
    </div>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Razón social</th><th>CUIT</th><th>Teléfono</th><th>Email</th><th class="col-center">Estado</th><th></th></tr>
        </thead>
        <tbody>
          <% rows.forEach(c => { %>
            <tr class="<%= !c.activo ? 'row-inactive' : '' %>">
              <td><%= c.razonSocial %></td>
              <td><%= c.cuit %></td>
              <td><%= c.telefono %></td>
              <td><%= c.email || '-' %></td>
              <td class="col-center"><span class="badge <%= c.activo ? 'badge-activo' : 'badge-inactivo' %>"><%= c.activo ? 'Activo' : 'Inactivo' %></span></td>
              <td>
                <div class="cell-actions">
                  <a href="/clientes/<%= c.id %>/negocio" class="icon-btn" title="Mi Negocio"><%- icons.fileText %></a>
                  <a href="/clientes/<%= c.id %>/pedidos" class="icon-btn" title="Pedidos"><%- icons.truck %></a>
                  <a href="/clientes/<%= c.id %>/articulos" class="icon-btn" title="Artículos"><%- icons.package %></a>
                  <a href="/clientes/<%= c.id %>/mensajes" class="icon-btn" title="Mensajes"><%- icons.message %></a>
                  <a href="/clientes/<%= c.id %>/consultas" class="icon-btn" title="Consultas"><%- icons.search %></a>
                  <a href="/clientes/<%= c.id %>/escalamientos" class="icon-btn" title="Escalamientos"><%- icons.alertTriangle %></a>
                  <a href="/clientes/<%= c.id %>/editar" class="icon-btn" title="Editar"><%- icons.edit %></a>
                  <% if (c.activo) { %>
                    <form method="POST" action="/clientes/<%= c.id %>/borrar" class="inline"
                          onsubmit="return confirm('¿Desactivar a <%= c.razonSocial %>? Deja de poder usar el bot y el portal, pero no se borra su historial.');">
                      <button type="submit" class="icon-btn danger" title="Desactivar"><%- icons.trash %></button>
                    </form>
                  <% } else { %>
                    <form method="POST" action="/clientes/<%= c.id %>/activar" class="inline">
                      <button type="submit" class="icon-btn" title="Reactivar"><%- icons.refresh %></button>
                    </form>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <%- include('partials/pagination') %>
  <% } %>
</div>

<%- include('partials/footer') %>
