<dialog id="shopify-sync-dialog" class="modal">
  <div id="shopify-sync-progreso">
    <h3>Sincronizando con Shopify...</h3>
    <progress id="shopify-sync-progress" style="width: 100%;"></progress>
    <p id="shopify-sync-texto" class="page-hint" style="margin: 0.75rem 0 0;">Leyendo productos de la tienda…</p>
  </div>

  <div id="shopify-sync-resultado" style="display: none;">
    <div class="modal-result">
      <div id="shopify-sync-icono-exito" class="modal-result-icon success" style="display: none;"><%- icons.check %></div>
      <div id="shopify-sync-icono-error" class="modal-result-icon error" style="display: none;"><%- icons.alertTriangle %></div>
      <h3 id="shopify-sync-titulo"></h3>
      <p id="shopify-sync-resumen" class="page-hint" style="margin: 0;"></p>
    </div>
    <ul id="shopify-sync-errores" class="page-hint" style="display: none; max-height: 160px; overflow: auto; font-size: 0.8rem;"></ul>
    <div class="modal-actions">
      <button type="button" class="btn btn-primary" onclick="cerrarSyncShopify()">Cerrar</button>
    </div>
  </div>
</dialog>

<script>
  function cerrarSyncShopify() {
    document.getElementById('shopify-sync-dialog').close();
    // Saca ?sync= de la URL para que recargar no reabra el diálogo.
    location.replace(location.pathname);
  }

  async function iniciarSyncShopify(clienteId) {
    let data;
    try {
      const resp = await fetch(`/clientes/${clienteId}/shopify/sync`, { method: 'POST' });
      data = await resp.json();
      if (!resp.ok) throw new Error(data.error);
    } catch (err) {
      mostrarToast('warning', 'No Se Pudo Iniciar La Sincronización');
      return;
    }
    seguirSyncShopify(clienteId, data.jobId);
  }

  function seguirSyncShopify(clienteId, jobId) {
    document.getElementById('shopify-sync-progreso').style.display = '';
    document.getElementById('shopify-sync-resultado').style.display = 'none';
    const dialog = document.getElementById('shopify-sync-dialog');
    if (!dialog.open) dialog.showModal();
    pollSyncShopify(clienteId, jobId);
  }

  async function pollSyncShopify(clienteId, jobId) {
    let estado;
    try {
      const resp = await fetch(`/clientes/${clienteId}/shopify/sync/${jobId}`);
      estado = await resp.json();
      if (!resp.ok) throw new Error(estado.error);
    } catch (err) {
      return mostrarResultadoSync({ errorFatal: err.message || 'Se perdió la conexión con el servidor.' });
    }

    const barra = document.getElementById('shopify-sync-progress');
    if (estado.total) {
      barra.max = estado.total;
      barra.value = estado.procesado;
      document.getElementById('shopify-sync-texto').textContent = `${estado.procesado} de ${estado.total} variantes procesadas`;
    } else if (estado.procesado) {
      document.getElementById('shopify-sync-texto').textContent = `${estado.procesado} variantes procesadas`;
    }

    if (!estado.terminado) return setTimeout(() => pollSyncShopify(clienteId, jobId), 800);
    mostrarResultadoSync(estado);
  }

  function mostrarResultadoSync(estado) {
    document.getElementById('shopify-sync-progreso').style.display = 'none';
    document.getElementById('shopify-sync-resultado').style.display = '';
    const ok = !estado.errorFatal && !estado.erroresCount;
    document.getElementById('shopify-sync-icono-exito').style.display = ok ? '' : 'none';
    document.getElementById('shopify-sync-icono-error').style.display = ok ? 'none' : '';

    const titulo = document.getElementById('shopify-sync-titulo');
    const resumen = document.getElementById('shopify-sync-resumen');
    const lista = document.getElementById('shopify-sync-errores');
    lista.style.display = 'none';

    if (estado.errorFatal) {
      titulo.textContent = 'No se pudo sincronizar';
      resumen.textContent = estado.errorFatal;
      return;
    }

    titulo.textContent = ok ? 'Catálogo sincronizado' : 'Sincronizado con errores';
    const partes = [`${estado.creados} nuevos`, `${estado.actualizados} actualizados`];
    if (estado.desactivados) partes.push(`${estado.desactivados} desactivados (ya no están en Shopify)`);
    if (estado.erroresCount) partes.push(`${estado.erroresCount} con error`);
    resumen.textContent = partes.join(' · ');

    if (estado.errores && estado.errores.length) {
      lista.innerHTML = '';
      estado.errores.forEach(e => {
        const li = document.createElement('li');
        li.textContent = e;
        lista.appendChild(li);
      });
      lista.style.display = '';
    }
  }
</script>
