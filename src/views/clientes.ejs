<%- include('partials/header') %>

<div class="topbar"><h1>Clientes</h1></div>

<div class="card">
  <div class="card-header">
    <span><strong><%= clientes.length %></strong>&nbsp;cliente<%= clientes.length === 1 ? '' : 's' %></span>
    <span><%= clientes.filter(c => c.activo).length %> activos</span>
  </div>
  <% if (!clientes.length) { %>
    <div class="empty-state">
      <%- icons.briefcase %>
      <p>No hay clientes cargados.</p>
    </div>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Razón social</th><th>CUIT</th><th>Teléfono</th><th>Email</th><th>Estado</th><th></th></tr>
        </thead>
        <tbody>
          <% clientes.forEach(c => { %>
            <tr class="<%= !c.activo ? 'row-inactive' : '' %>">
              <td><%= c.razonSocial %></td>
              <td><%= c.cuit %></td>
              <td><%= c.telefono %></td>
              <td><%= c.email || '-' %></td>
              <td><span class="badge <%= c.activo ? 'badge-activo' : 'badge-inactivo' %>"><%= c.activo ? 'Activo' : 'Inactivo' %></span></td>
              <td>
                <div class="cell-actions">
                  <a href="/clientes/<%= c.id %>/mensajes" class="icon-btn" title="Mensajes"><%- icons.message %></a>
                  <a href="/clientes/<%= c.id %>/pedidos" class="icon-btn" title="Pedidos"><%- icons.truck %></a>
                  <a href="/clientes/<%= c.id %>/escalamientos" class="icon-btn" title="Escalamientos"><%- icons.alertTriangle %></a>
                  <% if (c.activo) { %>
                    <form method="POST" action="/clientes/<%= c.id %>/borrar" class="inline"
                          onsubmit="return confirm('¿Desactivar a <%= c.razonSocial %>? Deja de poder usar el bot y el portal, pero no se borra su historial.');">
                      <button type="submit" class="icon-btn danger" title="Desactivar"><%- icons.trash %></button>
                    </form>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
