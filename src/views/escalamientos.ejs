<%- include('partials/header') %>

<div class="page-head">
  <div>
    <h1>Escalamientos</h1>
    <p class="page-sub">Casos que el bot te pasó porque necesitan una persona: reclamos, devoluciones o pedidos fuera de lo común.</p>
  </div>
</div>
<details class="page-help">
  <summary><%- icons.info %> ¿Cómo los manejo?</summary>
  <div>
    <p>Tocá el número para abrir el chat y hablar con el cliente. Si querés atenderlo vos, pausá el bot en ese chat.</p>
    <p>Cuando lo termines, marcalo <strong>Resuelto</strong> (es un estado final). Si el reclamo está ligado a un pedido, al marcar el pedido como <strong>Solucionado</strong> el escalamiento se resuelve solo.</p>
  </div>
</details>

<div class="stats">
  <div class="stat <%= pendientes ? 'stat-alert-danger' : '' %>"><span class="stat-icon tone-danger"><%- icons.alertTriangle %></span><div><strong><%= pendientes %></strong><span>sin resolver</span></div></div>
  <div class="stat"><span class="stat-icon tone-primary"><%- icons.inbox %></span><div><strong><%= total %></strong><span>en total</span></div></div>
</div>

<div class="card">
  <% if (!rows.length) { %>
    <div class="empty-state">
      <%- icons.alertTriangle %>
      <h3>Nada pendiente 🎉</h3>
      <p>Cuando el bot necesite que intervengas, el caso va a aparecer acá.</p>
    </div>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th class="col-fecha">Fecha</th><th>Cliente</th><th>Motivo</th><th class="col-center">Estado</th></tr>
        </thead>
        <tbody>
          <% rows.forEach(e => { %>
            <tr class="<%= e.estado === 'resuelto' ? 'row-done' : '' %>">
              <td class="col-fecha"><% const f = fecha(e.fecha); %><div class="cell-fecha"><span><%= f.dia %></span><small><%= f.hora %></small></div></td>
              <td><a class="contacto" href="/clientes/<%= clienteId %>/chats?chat=<%= encodeURIComponent(e.userId) %>" title="Abrir el chat"><%- icons.message %><% if (e.contactoNombre) { %><span class="contacto-texto"><strong><%= e.contactoNombre %></strong><small><%= numero(e.userId) %></small></span><% } else { %><%= numero(e.userId) %><% } %></a></td>
              <td class="cell-motivo"><%= e.motivo %></td>
              <td class="col-center">
                <% if (e.estado === 'resuelto') { %>
                  <span class="badge badge-resuelto">Resuelto</span>
                <% } else { %>
                  <form method="POST" action="/clientes/<%= clienteId %>/escalamientos/<%= e.id %>/estado" class="inline">
                    <select name="estado" onchange="this.form.submit()" class="badge-select badge-<%= e.estado %>">
                      <option value="pendiente" <%= e.estado === 'pendiente' ? 'selected' : '' %>>Pendiente</option>
                      <option value="en_proceso" <%= e.estado === 'en_proceso' ? 'selected' : '' %>>En proceso</option>
                      <option value="resuelto">Resuelto</option>
                    </select>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <%- include('partials/pagination') %>
  <% } %>
</div>

<%- include('partials/footer') %>
