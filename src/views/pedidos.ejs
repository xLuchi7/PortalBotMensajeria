<%- include('partials/header') %>

<div class="topbar"><h1>Pedidos</h1></div>
<p class="page-hint">Al marcar un pedido como <strong>Entregado</strong> se descuenta el Stock de cada artículo. "Entregado", "Cancelado" y "Solucionado" son estados finales: una vez ahí no se pueden volver a cambiar. Un pedido pasa a <strong>Reclamado</strong> automáticamente cuando el bot detecta un reclamo sobre él; al marcarlo <strong>Solucionado</strong> se devuelve el Stock y se resuelve el Escalamiento asociado.</p>

<div class="card">
  <div class="card-header">
    <span><strong><%= total %></strong>&nbsp;pedido<%= total === 1 ? '' : 's' %></span>
    <span>Total: <strong>$<%= Number(totalMonto).toLocaleString('es-AR') %></strong></span>
  </div>
  <% if (!rows.length) { %>
    <div class="empty-state">
      <%- icons.truck %>
      <p>No hay pedidos.</p>
    </div>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th class="col-id">#</th><th class="col-fecha">Fecha</th><th class="col-usuario">Usuario</th><th>Total</th><th class="col-center">Estado</th><th>Notas</th><th></th></tr>
        </thead>
        <tbody>
          <% const ESTADOS_FINALES = ['entregado', 'cancelado', 'solucionado']; %>
          <% const ESTADO_LABEL = { entregado: 'Entregado', cancelado: 'Cancelado', solucionado: 'Solucionado' }; %>
          <% rows.forEach(p => { %>
            <tr>
              <td>#<%= p.id %></td>
              <td class="col-fecha"><%= p.fecha %></td>
              <td class="col-usuario"><%= p.userId %></td>
              <td>$<%= Number(p.total).toLocaleString('es-AR') %></td>
              <td class="col-center">
                <% if (p.estado === 'reclamado') { %>
                  <form method="POST" action="/clientes/<%= clienteId %>/pedidos/<%= p.id %>/estado" class="inline">
                    <select name="estado" onchange="this.form.submit()" class="badge-select badge-reclamado">
                      <option value="reclamado" selected>Reclamado</option>
                      <option value="solucionado">Solucionado</option>
                    </select>
                  </form>
                <% } else if (ESTADOS_FINALES.includes(p.estado)) { %>
                  <span class="badge badge-<%= p.estado %>"><%= ESTADO_LABEL[p.estado] %></span>
                <% } else { %>
                  <form method="POST" action="/clientes/<%= clienteId %>/pedidos/<%= p.id %>/estado" class="inline">
                    <select name="estado" onchange="this.form.submit()" class="badge-select badge-<%= p.estado %>">
                      <option value="pendiente" <%= p.estado === 'pendiente' ? 'selected' : '' %>>Pendiente</option>
                      <option value="confirmado" <%= p.estado === 'confirmado' ? 'selected' : '' %>>Confirmado</option>
                      <option value="entregado">Entregado</option>
                      <option value="cancelado">Cancelado</option>
                    </select>
                  </form>
                <% } %>
              </td>
              <td>
                <div class="notas-cell">
                  <span><%= p.notas || '-' %></span>
                  <button type="button" class="icon-btn" title="Editar notas" onclick="abrirNotas(<%= p.id %>, <%= JSON.stringify(p.notas || '') %>)"><%- icons.edit %></button>
                </div>
              </td>
              <td>
                <a href="/clientes/<%= clienteId %>/pedidos/<%= p.id %>" class="icon-btn" title="Ver detalle"><%- icons.eye %></a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <%- include('partials/pagination') %>
  <% } %>
</div>

<dialog id="notas-dialog" class="modal">
  <form method="POST" id="notas-form">
    <h3>Notas del pedido #<span id="notas-dialog-pedido"></span></h3>
    <textarea name="notas" id="notas-textarea" rows="5" maxlength="500" placeholder="Sin notas"></textarea>
    <div class="modal-actions">
      <button type="button" class="btn btn-outline" onclick="document.getElementById('notas-dialog').close()">Cancelar</button>
      <button type="submit" class="btn btn-primary">Guardar</button>
    </div>
  </form>
</dialog>

<script>
  const CLIENTE_ID = <%= clienteId %>;
  function abrirNotas(pedidoId, notas) {
    document.getElementById('notas-form').action = `/clientes/${CLIENTE_ID}/pedidos/${pedidoId}/notas`;
    document.getElementById('notas-dialog-pedido').textContent = pedidoId;
    document.getElementById('notas-textarea').value = notas;
    document.getElementById('notas-dialog').showModal();
  }
</script>

<%- include('partials/footer') %>
