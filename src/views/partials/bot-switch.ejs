<%#
  Interruptor del bot. Parámetros:
  action, activo (bool), volver (url de vuelta sin JS), titulo { on, off }, texto { on, off },
  ajax (default true): footer.ejs intercepta el submit (fetch + toast, sin recargar).
    Con ajax: false es un submit común (redirect + toast), para cuando el cambio
    tiene que verse en otras partes de la página, como el aviso del sidebar.
  compacto (default false): versión chica para la cabecera de un chat.
  ayuda (opcional): explicación larga, va como tooltip.
%>
<% const esCompacto = typeof compacto !== 'undefined' && compacto; %>
<form method="POST" action="<%= action %>" class="bot-switch <%= esCompacto ? 'bot-switch-compacto' : '' %> <%= activo ? 'is-on' : 'is-off' %>"
      <%= typeof ajax !== 'undefined' && ajax === false ? '' : 'data-bot-switch' %>
      <% if (typeof ayuda !== 'undefined' && ayuda) { %>title="<%= ayuda %>"<% } %>
      data-titulo-on="<%= titulo.on %>" data-titulo-off="<%= titulo.off %>"
      data-texto-on="<%= texto.on %>" data-texto-off="<%= texto.off %>">
  <input type="hidden" name="activo" value="<%= activo ? '0' : '1' %>">
  <input type="hidden" name="volver" value="<%= volver %>">
  <% if (!esCompacto) { %><div class="bot-switch-icon"><%- icons.bot %></div><% } %>
  <div class="bot-switch-body">
    <div class="bot-switch-title" data-titulo><%= activo ? titulo.on : titulo.off %></div>
    <div class="bot-switch-text" data-texto><%= activo ? texto.on : texto.off %></div>
  </div>
  <button type="submit" class="bot-toggle" role="switch" aria-checked="<%= activo ? 'true' : 'false' %>"
          aria-label="<%= activo ? 'Apagar el bot' : 'Encender el bot' %>">
    <% if (!esCompacto) { %>
      <span class="bot-toggle-label bot-toggle-on">Responde</span>
      <span class="bot-toggle-label bot-toggle-off">No Responde</span>
    <% } %>
    <span class="bot-toggle-knob"></span>
  </button>
</form>
