<%- include('partials/header') %>
<%
  const base = `/clientes/${clienteId}/chats`;
  // Arma links conservando los filtros actuales; `cambios` pisa lo que haga falta.
  function link(cambios) {
    const p = { q: filtros.q, estado: filtros.estado, bot: filtros.bot, page: page > 1 ? page : '', chat: chatId, ...cambios };
    const qs = Object.entries(p).filter(([, v]) => v !== '' && v != null).map(([k, v]) => `${k}=${encodeURIComponent(v)}`).join('&');
    return qs ? `${base}?${qs}` : base;
  }
  const hayFiltro = filtros.q || filtros.estado || filtros.bot;
  const urlActual = link({});
  // Color de avatar fijo por número, para reconocer cada contacto de un vistazo.
  const tono = id => String(id).split('').reduce((a, d) => a + d.charCodeAt(0), 0) % 6;
%>

<div class="page-head">
  <div>
    <h1>Chats</h1>
    <p class="page-sub">Todas las conversaciones de tus clientes. Abrí un chat para leerlo, responder vos o pausar el bot.</p>
  </div>
  <div class="page-actions">
    <span class="pill"><strong><%= resumen.total %></strong> chat<%= resumen.total === 1 ? '' : 's' %></span>
    <% if (resumen.pausados) { %><span class="pill pill-danger"><%- icons.pause %> <strong><%= resumen.pausados %></strong> con el bot pausado</span><% } %>
  </div>
</div>

<% if (cliente && cliente.botActivo === false) { %>
  <div class="bot-banner">
    <%- icons.power %>
    <div><strong>El bot está apagado para todos los chats.</strong> Nadie está recibiendo respuestas automáticas.</div>
    <a href="/clientes/<%= clienteId %>/negocio" class="btn btn-outline">Encenderlo en Mi Negocio</a>
  </div>
<% } %>

<div class="chat-filtros">
  <form method="GET" action="<%= base %>" class="chat-search">
    <%- icons.search %>
    <input type="search" name="q" value="<%= filtros.q %>" placeholder="Buscar por nombre o número" autocomplete="off">
    <% if (filtros.estado) { %><input type="hidden" name="estado" value="<%= filtros.estado %>"><% } %>
    <% if (filtros.bot) { %><input type="hidden" name="bot" value="<%= filtros.bot %>"><% } %>
  </form>
  <div class="chip-row">
    <a href="<%= link({ estado: '', bot: '', page: '' }) %>" class="chip <%= !filtros.estado && !filtros.bot ? 'active' : '' %>">Todos <span><%= resumen.total %></span></a>
    <% Object.entries(estados).forEach(([clave, e]) => { %>
      <a href="<%= link({ estado: filtros.estado === clave ? '' : clave, page: '' }) %>" class="chip chip-<%= clave %> <%= filtros.estado === clave ? 'active' : '' %>"><%= e.label %> <span><%= resumen[clave] %></span></a>
    <% }) %>
    <a href="<%= link({ bot: filtros.bot === 'pausado' ? '' : 'pausado', page: '' }) %>" class="chip chip-pausado <%= filtros.bot === 'pausado' ? 'active' : '' %>"><%- icons.pause %> Bot Pausado <span><%= resumen.pausados %></span></a>
  </div>
</div>

<div class="inbox card <%= chat ? 'has-chat' : '' %>">
  <aside class="inbox-list">
    <% if (!rows.length) { %>
      <div class="empty-state">
        <%- icons.inbox %>
        <p><%= hayFiltro ? 'No hay chats con ese filtro.' : 'Todavía no hay chats.' %></p>
      </div>
    <% } else { %>
      <div class="chat-items" id="chat-items">
        <% rows.forEach(c => { %>
          <a href="<%= link({ chat: c.userId }) %>" class="chat-item <%= chatId === c.userId ? 'active' : '' %> <%= c.botActivo ? '' : 'is-paused' %>">
            <div class="chat-avatar tono-<%= tono(c.userId) %>"><% if (c.nombreVisible) { %><%= iniciales(c.nombreVisible) %><% } else { %><%- icons.user %><% } %></div>
            <div class="chat-item-body">
              <div class="chat-item-top">
                <span class="chat-item-numero"><%= c.nombreVisible || c.numero %></span>
                <span class="chat-item-fecha"><%= c.fechaCorta %></span>
              </div>
              <div class="chat-item-preview">
                <% if (c.ultimoRol !== 'user') { %><span class="chat-item-quien"><%= c.ultimoEsError ? 'Error:' : c.ultimoEnviadoPor ? 'Vos:' : 'Bot:' %></span><% } %>
                <%= c.ultimoMensaje %>
              </div>
              <div class="chat-item-tags">
                <span class="tag <%= c.estadoInfo.clase %>"><%= c.estadoInfo.label %></span>
                <span class="tag tag-pausado"><%- icons.pause %> Bot Pausado</span>
                <% if (c.nombreVisible) { %><span class="chat-item-tel"><%= c.numero %></span><% } %>
              </div>
            </div>
          </a>
        <% }) %>
      </div>
      <% if (totalPages > 1) { %>
        <div class="inbox-pagination">
          <% if (page > 1) { %><a href="<%= link({ page: page - 1 }) %>" class="btn btn-outline">&larr;</a><% } else { %><span class="btn btn-outline disabled">&larr;</span><% } %>
          <span class="pagination-info"><%= page %> / <%= totalPages %></span>
          <% if (page < totalPages) { %><a href="<%= link({ page: page + 1 }) %>" class="btn btn-outline">&rarr;</a><% } else { %><span class="btn btn-outline disabled">&rarr;</span><% } %>
        </div>
      <% } %>
    <% } %>
  </aside>

  <section class="inbox-panel">
    <% if (chat) { %>
      <header class="chat-header">
        <a href="<%= link({ chat: '' }) %>" class="chat-back" aria-label="Volver a los chats"><%- icons.arrowLeft %></a>
        <div class="chat-avatar chat-avatar-lg tono-<%= tono(chat.userId) %>"><% if (chat.nombreVisible) { %><%= iniciales(chat.nombreVisible) %><% } else { %><%- icons.user %><% } %></div>
        <div class="chat-header-info">
          <div class="chat-nombre" id="chat-nombre">
            <strong><%= chat.nombreVisible || chat.numero %></strong>
            <button type="button" class="icon-btn icon-btn-sm" title="<%= chat.nombre ? 'Cambiar el nombre' : 'Ponerle un nombre' %>" onclick="editarNombre(true)"><%- icons.edit %></button>
          </div>
          <form method="POST" action="/clientes/<%= clienteId %>/chats/<%= encodeURIComponent(chat.userId) %>/nombre" class="chat-nombre-form" id="chat-nombre-form" hidden>
            <input type="hidden" name="volver" value="<%= urlActual %>">
            <input type="text" name="nombre" maxlength="100" value="<%= chat.nombre || '' %>"
                   placeholder="<%= chat.nombrePerfil ? `En WhatsApp: ${chat.nombrePerfil}` : 'Ej: Juan de Palermo' %>" aria-label="Nombre del contacto">
            <button type="submit" class="icon-btn icon-btn-sm icon-btn-ok" title="Guardar"><%- icons.check %></button>
            <button type="button" class="icon-btn icon-btn-sm" title="Cancelar" onclick="editarNombre(false)"><%- icons.x %></button>
          </form>
          <span class="chat-header-sub">
            <% if (chat.nombreVisible) { %><%= chat.numero %> · <% } %>
            <% if (chat.nombre && chat.nombrePerfil && chat.nombre !== chat.nombrePerfil) { %><span title="Nombre de su perfil de WhatsApp">“<%= chat.nombrePerfil %>”</span> · <% } %>
            <%= chat.cantidad %> mensaje<%= chat.cantidad === 1 ? '' : 's' %>
            <span class="tag <%= chat.estadoInfo.clase %>"><%= chat.estadoInfo.label %></span>
          </span>
        </div>
        <%- include('partials/bot-switch', {
          compacto: true,
          action: `/clientes/${clienteId}/chats/${encodeURIComponent(chat.userId)}/bot`,
          activo: chat.botActivo,
          volver: urlActual,
          titulo: { on: 'Bot respondiendo', off: 'Bot pausado' },
          texto: { on: 'Contesta solo en este chat', off: 'Respondés vos' },
          ayuda: chat.botActivo
            ? 'El bot contesta solo cada mensaje de este número. Pausalo si querés atenderlo vos.'
            : `El bot no le contesta nada a este número hasta que lo actives. Los mensajes nuevos se siguen viendo acá.${chat.botActualizadoEn ? ` Pausado el ${chat.botActualizadoEn}${chat.botActualizadoPor ? ` por ${chat.botActualizadoPor}` : ''}.` : ''}`,
        }) %>
      </header>
      <% if (cliente && cliente.botActivo === false) { %>
        <div class="chat-aviso"><%- icons.power %> El bot está apagado en general: no responde en ningún chat, tampoco en este. <a href="/clientes/<%= clienteId %>/negocio">Encenderlo</a></div>
      <% } %>

      <div class="chat-thread" id="chat-thread">
        <% let diaAnterior = null; %>
        <% chat.mensajes.forEach(m => { %>
          <% if (m.dia !== diaAnterior) { diaAnterior = m.dia; %>
            <div class="chat-dia"><span><%= m.dia %></span></div>
          <% } %>
          <div class="burbuja <%= m.role === 'user' ? 'burbuja-cliente' : m.enviadoPor ? 'burbuja-humano' : 'burbuja-bot' %> <%= m.esError ? 'burbuja-error' : '' %>">
            <% if (m.role !== 'user' && m.enviadoPor) { %>
              <span class="burbuja-autor"><%- icons.user %> <%= m.enviadoPor === usuario.email ? 'Vos' : m.enviadoPor %></span>
            <% } else if (m.role !== 'user') { %>
              <span class="burbuja-autor"><%- icons.bot %> Bot</span>
            <% } %>
            <div class="burbuja-texto"><%= m.content %></div>
            <span class="burbuja-hora"><%= m.hora %></span>
          </div>
        <% }) %>
      </div>

      <% if (!envioHabilitado) { %>
        <div class="chat-composer-off">Para responder desde acá falta configurar BOT_URL y BOT_API_TOKEN en el portal.</div>
      <% } else if (!chat.ventanaAbierta) { %>
        <div class="chat-composer-off"><%- icons.lock %> Pasaron más de 24 hs desde su último mensaje: WhatsApp no deja escribirle hasta que te vuelva a escribir.</div>
      <% } else { %>
        <form method="POST" action="/clientes/<%= clienteId %>/chats/<%= encodeURIComponent(chat.userId) %>/enviar" class="chat-composer" id="chat-composer">
          <input type="hidden" name="volver" value="<%= urlActual %>">
          <textarea name="texto" rows="1" maxlength="4096" placeholder="Escribí tu respuesta… (Enter envía, Shift+Enter baja de línea)" required></textarea>
          <button type="submit" class="btn btn-primary"><%- icons.send %> Enviar</button>
          <div class="chat-composer-hint">
            <% if (chat.botActivo) { %>Al enviar, el bot se pausa en este chat para no contestar encima tuyo · <% } %>
            Podés escribirle por <%= Math.floor(chat.ventanaRestante / 60) %> h <%= chat.ventanaRestante % 60 %> min más
          </div>
        </form>
      <% } %>
    <% } else if (chatId) { %>
      <div class="empty-state inbox-empty">
        <%- icons.inbox %>
        <p>No encontramos ese chat.</p>
      </div>
    <% } else { %>
      <div class="empty-state inbox-empty">
        <%- icons.message %>
        <p><strong>Elegí un chat</strong><br>para ver la conversación y pausar o activar el bot en ese número.</p>
      </div>
    <% } %>
  </section>
</div>

<script>
  // Conversación abierta: arranca abajo de todo, como en WhatsApp.
  const thread = document.getElementById('chat-thread');
  if (thread) thread.scrollTop = thread.scrollHeight;

  // Editar el nombre del contacto en el lugar (Escape cancela).
  function editarNombre(abrir) {
    const vista = document.getElementById('chat-nombre');
    const form = document.getElementById('chat-nombre-form');
    vista.hidden = abrir;
    form.hidden = !abrir;
    if (abrir) { const input = form.querySelector('input[name="nombre"]'); input.focus(); input.select(); }
  }
  const formNombre = document.getElementById('chat-nombre-form');
  if (formNombre) formNombre.addEventListener('keydown', (e) => { if (e.key === 'Escape') editarNombre(false); });

  // Caja para responder: Enter envía, Shift+Enter baja de línea, crece con el texto.
  const composer = document.getElementById('chat-composer');
  if (composer) {
    const area = composer.querySelector('textarea');
    const crecer = () => { area.style.height = 'auto'; area.style.height = Math.min(area.scrollHeight, 160) + 'px'; };
    area.addEventListener('input', crecer);
    area.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey && !e.isComposing) { e.preventDefault(); composer.requestSubmit(); }
    });
    composer.addEventListener('submit', (e) => {
      if (e.defaultPrevented || !area.value.trim()) return;
      composer.querySelector('button').disabled = true;
    });
  }

  // Refresco automático para ver mensajes nuevos, solo si no estás leyendo algo
  // viejo, escribiendo en el buscador o con un modal abierto.
  setInterval(() => {
    if (document.hidden || document.querySelector('dialog[open]')) return;
    if (document.activeElement && ['INPUT', 'TEXTAREA'].includes(document.activeElement.tagName)) return;
    if (composer && composer.querySelector('textarea').value.trim()) return;
    if (thread && thread.scrollHeight - thread.scrollTop - thread.clientHeight > 40) return;
    const lista = document.getElementById('chat-items');
    if (lista && lista.scrollTop > 40) return;
    location.reload();
  }, 20000);
</script>

<%- include('partials/footer') %>
