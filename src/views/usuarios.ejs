<%- include('partials/header') %>

<div class="page-head">
  <div>
    <h1>Usuarios</h1>
    <p class="page-sub">Quién puede entrar al portal. Un usuario <strong>Cliente</strong> solo ve su negocio; un <strong>Admin</strong> ve todos.</p>
  </div>
  <div class="page-actions"><a href="/usuarios/nuevo" class="btn btn-primary"><%- icons.plus %> Nuevo usuario</a></div>
</div>

<div class="card">
  <% if (!rows.length) { %>
    <div class="empty-state">
      <%- icons.users %>
      <p>No hay usuarios cargados.</p>
    </div>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Email</th><th class="col-center">Rol</th><th>Cliente</th><th class="col-center">Estado</th><th></th></tr>
        </thead>
        <tbody>
          <% rows.forEach(u => { %>
            <tr>
              <td><span class="cell-cliente"><span class="avatar avatar-sm"><%= iniciales(u.email) %></span><%= u.email %></span></td>
              <td class="col-center"><span class="badge badge-<%= u.rol %>"><%= u.rol %></span></td>
              <td><%= u.razonSocial || '-' %></td>
              <td class="col-center"><span class="badge <%= u.activo ? 'badge-activo' : 'badge-inactivo' %>"><%= u.activo ? 'Activo' : 'Inactivo' %></span></td>
              <td>
                <div class="cell-actions">
                  <a href="/usuarios/<%= u.id %>/editar" class="icon-btn" title="Editar"><%- icons.edit %></a>
                  <form method="POST" action="/usuarios/<%= u.id %>/borrar" class="inline">
                    <button type="button" class="icon-btn danger" title="Borrar"
                            onclick="confirmarEliminar('¿Borrar el usuario «<%= u.email %>»? No se puede deshacer.', this.closest('form'))"><%- icons.trash %></button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <%- include('partials/pagination') %>
  <% } %>
</div>

<%- include('partials/footer') %>
