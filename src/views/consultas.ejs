<%- include('partials/header') %>

<div class="page-head">
  <div>
    <h1>Consultas</h1>
    <p class="page-sub">Qué buscan tus clientes y quién preguntó por su pedido. Ideal para detectar productos que te faltan.</p>
  </div>
</div>

<div class="stats">
  <div class="stat"><span class="stat-icon tone-primary"><%- icons.search %></span><div><strong><%= total %></strong><span>consultas</span></div></div>
  <div class="stat <%= sinStock ? 'stat-alert-warning' : '' %>"><span class="stat-icon tone-warning"><%- icons.package %></span><div><strong><%= sinStock %></strong><span>pidieron algo sin stock</span></div></div>
</div>

<div class="card">
  <% if (!rows.length) { %>
    <div class="empty-state">
      <%- icons.search %>
      <h3>Todavía no hay consultas</h3>
      <p>Cada vez que alguien busque un producto o pregunte por su pedido, lo vas a ver acá.</p>
    </div>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th class="col-fecha">Fecha</th><th>Cliente</th><th class="col-center">Tipo</th><th>Detalle</th><th class="col-center">Estado</th></tr>
        </thead>
        <tbody>
          <% const ESTADO_LABEL = { pendiente: 'Pendiente', confirmado: 'Confirmado', entregado: 'Entregado', cancelado: 'Cancelado', reclamado: 'Reclamado', solucionado: 'Solucionado' }; %>
          <% rows.forEach(c => { %>
            <tr>
              <td class="col-fecha"><% const f = fecha(c.fecha); %><div class="cell-fecha"><span><%= f.dia %></span><small><%= f.hora %></small></div></td>
              <td><a class="contacto" href="/clientes/<%= clienteId %>/chats?chat=<%= encodeURIComponent(c.userId) %>" title="Abrir el chat"><%- icons.message %><% if (c.contactoNombre) { %><span class="contacto-texto"><strong><%= c.contactoNombre %></strong><small><%= numero(c.userId) %></small></span><% } else { %><%= numero(c.userId) %><% } %></a></td>
              <td class="col-center">
                <% if (c.tipo === 'articulo') { %>
                  <span class="badge badge-info">Artículo</span>
                <% } else { %>
                  <span class="badge badge-warning">Pedido</span>
                <% } %>
              </td>
              <td>
                <% if (c.tipo === 'articulo') { %>
                  Buscó <strong>"<%= c.detalle %>"</strong><% if (c.articuloNombre) { %> <span class="muted">→ <%= c.articuloNombre %></span><% } else { %> <span class="muted">→ no lo encontró</span><% } %>
                <% } else { %>
                  Consultó el estado de sus pedidos<% if (c.pedidoId) { %> — Pedido #<%= c.pedidoId %><% } %>
                <% } %>
              </td>
              <td class="col-center">
                <% if (c.tipo === 'articulo') { %>
                  <% if (c.sinStock) { %>
                    <span class="badge badge-danger">Sin stock</span>
                  <% } %>
                <% } else if (c.pedidoEstado) { %>
                  <span class="badge badge-<%= c.pedidoEstado %>"><%= ESTADO_LABEL[c.pedidoEstado] || c.pedidoEstado %></span>
                <% } else { %>
                  <span class="badge badge-danger">Sin pedidos</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <%- include('partials/pagination') %>
  <% } %>
</div>

<%- include('partials/footer') %>
