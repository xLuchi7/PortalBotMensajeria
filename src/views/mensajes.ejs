<%- include('partials/header') %>

<div class="topbar"><h1>Mensajes</h1></div>

<div class="card">
  <div class="card-header"><span><strong><%= total %></strong>&nbsp;mensaje<%= total === 1 ? '' : 's' %></span></div>
  <% if (!rows.length) { %>
    <div class="empty-state">
      <%- icons.inbox %>
      <p>Todavía no hay mensajes.</p>
    </div>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Fecha</th><th>Usuario</th><th>Plataforma</th><th class="col-center">Quién</th><th>Mensaje</th></tr>
        </thead>
        <tbody>
          <% rows.forEach(m => { %>
            <tr class="<%= m.esError ? 'row-error' : '' %>">
              <td><%= new Date(m.fecha).toLocaleString('es-AR') %></td>
              <td><%= m.userId %></td>
              <td><%= m.platform %></td>
              <td class="col-center">
                <span class="badge <%= m.role === 'user' ? 'badge-cliente' : 'badge-info' %>">
                  <%= m.role === 'user' ? 'Cliente' : 'Bot' %>
                </span>
              </td>
              <td><%= m.content %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% if (totalPages > 1) { %>
      <div class="pagination">
        <% if (page > 1) { %>
          <a href="?page=<%= page - 1 %>" class="btn btn-outline">&larr; Anterior</a>
        <% } else { %>
          <span class="btn btn-outline disabled">&larr; Anterior</span>
        <% } %>
        <span class="pagination-info">Página <%= page %> de <%= totalPages %></span>
        <% if (page < totalPages) { %>
          <a href="?page=<%= page + 1 %>" class="btn btn-outline">Siguiente &rarr;</a>
        <% } else { %>
          <span class="btn btn-outline disabled">Siguiente &rarr;</span>
        <% } %>
      </div>
    <% } %>
  <% } %>
</div>

<%- include('partials/footer') %>
